{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Class Room </h1>
    </nav>
  </header>

    <section id="reading">
      <form class="reading-form" method="post">

        <h2>Word Recognition and Reading Enrichment</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="word-recognition-range">
          </div>
        
        <h2>Comprehension</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="comprehension-range">
          </div>
        
        <h2>Critical Analysis</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="critical-analysis-range">
          </div>

        <h2>Effort</h2>
          <div class="checkbox-container">
          <p>Is the student displaying a consistent effort for Reading? Tick the box for yes, leave blank for no.</p>
            <input type="checkbox" value="consistent" name="reading-effort">
          </div>

        <button> Next </button>
        
      </form>

      <div class="key">
        <h2>Key</h2>
          <h3>1 - Emerging</h3>
          <h3>2 - Developing</h3>
          <h3>3 - Consolidating</h3>
          <h3>4 - Proficient</h3>
          <h3>5 - Exceeding</h3>
      </div>

    </section>

{% endblock %}


