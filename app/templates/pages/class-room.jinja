{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/" aria-label="back button"><img src="static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Class Room </h1>
    </nav>
  </header>

  

    <section id="class-list">

      {% for student in students %} 
        <a href="/student-info/{{ student.id }}" class="student">
              <h2>{{ student.id   }}</h2>
              <div id="divider"></div>
              <h2>{{ student.name }}</h2>

        {% else %}
        <p>There are no reports to view! Sit back and relax, go watch some <a href="https://www.netflix.com">Netflix.</a></p>
      
      {% endfor %}

    </section>

{% endblock %}

