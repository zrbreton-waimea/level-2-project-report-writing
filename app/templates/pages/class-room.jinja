{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <a href="/"><img src="static/images/circle-arrow-left.svg" alt="back-button-icon" class="back-btn"></a>
    <h1> Class Room </h1>
  </header>

    <section id="report-preview">

      {% for item in list %}

          <form id="student-report" method="update" action="/report-preview/update">
              <h2>{{ item.student_id      }}</h2>

              <h3>Maths Ratings</h3>

              <label>{{ item.maths_meas       }}</label>
              <label>{{ item.maths_alge       }}</label>
              <label>{{ item.maths_numb       }}</label>
              <label>{{ item.maths_geom       }}</label>
              <label>{{ item.maths_stat       }}</label>
              <label>{{ item.maths_behaviour  }}</label>
          
          </form>

        {% else %}
          <p>There are no reports to view! Sit back and relax, go watch some <a href="https://www.netflix.com">Netflix.</a></p>

      {% endfor %}

    </section>

{% endblock %}

