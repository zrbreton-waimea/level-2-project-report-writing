{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/student-info/{{ student.id }}"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1>Subject Performance</h1>
    </nav>
  </header>

    <section class="form-page">
      <form class="maths-form" method="post">
      
        <div class="key">
          <h2>Key</h2>
            <div class="keys">
              <h3>1 - Emerging</h3>
              <h3>2 - Developing</h3>
              <h3>3 - Consolidating</h3>
              <h3>4 - Proficient</h3>
              <h3>5 - Exceeding</h3>
            </div>
        </div>
        
          <fieldset>
          <legend>Measurement</legend>
            <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-a" name="measurment-range">
              <datalist id="step-list-a">
                <option value="1" label="1"></option>
                <option value="2" label="2"></option>
                <option value="3" label="3"></option>
                <option value="4" label="4"></option>
                <option value="5" label="5"></option>
              </datalist>
          </fieldset>
           
         <fieldset>
          <legend>Algebra</legend> 
            <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-b" name="algebra-range">
              <datalist id="step-list-b">
                <option value="1" label="1"></option>
                <option value="2" label="2"></option>
                <option value="3" label="3"></option>
                <option value="4" label="4"></option>
                <option value="5" label="5"></option>
              </datalist>
         </fieldset> 
          
          <fieldset>
            <legend>Number</legend>
              <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-c" name="number-range">
                <datalist id="step-list-c">
                  <option value="1" label="1"></option>
                  <option value="2" label="2"></option>
                  <option value="3" label="3"></option>
                  <option value="4" label="4"></option>
                  <option value="5" label="5"></option>
                </datalist> 
          </fieldset>

          <fieldset>
            <legend>Geometry</legend> 
              <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-d" name="geometry-range">
                <datalist id="step-list-d">
                  <option value="1" label="1"></option>
                  <option value="2" label="2"></option>
                  <option value="3" label="3"></option>
                  <option value="4" label="4"></option>
                  <option value="5" label="5"></option>
                </datalist>
          </fieldset>
        
          <fieldset>
            <legend>Statistics</legend>
                <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-e" name="statistics-range">
                  <datalist id="step-list-e">
                    <option value="1" label="1"></option>
                    <option value="2" label="2"></option>
                    <option value="3" label="3"></option>
                    <option value="4" label="4"></option>
                    <option value="5" label="5"></option>
                  </datalist>
          </fieldset>

          <div class="checkbox-container">
            <h2>Effort</h2>
            <p>Is the student displaying a consistent effort for Maths? Tick the box for yes, leave blank for no.</p>
            <input type="checkbox" name="maths-effort" class="check-box">
          </div>

        <button> Next </button>
        
        
      </form>

      

    </section> 

{% endblock %}
