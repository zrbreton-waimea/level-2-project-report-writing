{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1>Subject Performance</h1>
    </nav>
  </header>

    <section id="maths">
      <form class="maths-form" method="post">

        <h2>Measurement</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="measurment-range">
          </div>
        
        <h2>Algebra</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="algebra-range">
          </div>
        
        <h2>Number</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="number-range">
          </div>

        <h2>Geometry</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="geometry-range">
          </div>
        
        <h2>Statistics</h2>
          <div class="slide-container">
            <input type="range" min="1" max="5" value="1" class="slider" name="statistics-range">
          </div>

        <h2>Effort</h2>
          <div class="checkbox-container">
          <p>Is the student displaying a consistent effort for Maths? Tick the box for yes, leave blank for no.</p>
            <input type="checkbox" value="consistent" name="maths-effort">
          </div>

        <button> Next </button>
        
      </form>

      <div class="key">
        <h2>Key</h2>
          <h3>1 - Emerging</h3>
          <h3>2 - Developing</h3>
          <h3>3 - Consolidating</h3>
          <h3>4 - Proficient</h3>
          <h3>5 - Exceeding</h3>
      </div>

    </section>

{% endblock %}
