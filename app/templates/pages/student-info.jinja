{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/class-room" aria-label="back button"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Student Info </h1>
    </nav>
  </header>

  <section class="student-info">

    <div class="student-data">
      <h2>Name: {{ student.name }}</h2>
      <div id="divider"></div>
      <h3>Student ID: {{ student.id }}</h3>
    </div>  

    <div class="delete-btn">
      <a href="/student-info/{{ student.id }}/delete" aria-label="delete button"><img src="/static/images/trash.svg" alt="back-button-icon"></a>
    </div>

    <div class="terms">

    {% for term in range(1, 5) %}

      {% set ns = namespace(report_found=false) %}

      <div class="term">
        <h2>Term {{ term }}</h2>

        {% for report in reports %}
          {% if report.term == term %}

            <a href="/student-info/{{ student.id }}/report-form/{{ term }}/report" class="report-view-btn">View Report <img src="/static/images/file.svg" alt="file-icon"></a>

             <a type="button" href="/student-info/{{ student.id }}/report-form/{{ term }}/edit" class="edit-btn">Edit <img src="/static/images/pencil-line.svg" alt="pencil-icon"></a>

              {% set ns.report_found = true %}
            </div>
          {% endif%}
        {% endfor %}

        {% if ns.report_found == false %}
            <div class="add-btn">
                    <a href="/student-info/{{ student.id }}/report-form/{{ term }}"><img src="/static/images/circle-plus.svg" alt="add-button-icon"></a>
            </div>
          {% endif%}
      </div>
    {% endfor %}
  </section>
  

{% endblock %}

