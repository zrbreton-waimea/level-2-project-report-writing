{#=====================================================
  Add Student Page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/" aria-label="back button"><img src="static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Add Student </h1>
    </nav>
  </header>


    <section id="add-student-form">

      <form method="post">
        <fieldset class="text-input">
          <legend>Student ID</legend>
          <input type="text" name="student-id-import">
        </fieldset>

        <fieldset class="text-input">
          <legend>Full Name</legend>
          <input type="text" name="student-name-import">
        </fieldset>

        <button>Add</button>

      </form>
    </section>

{% endblock %}

