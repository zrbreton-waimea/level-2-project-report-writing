{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Class Room </h1>
    </nav>
  </header>

    <section id="writing">
      <form class="writing-form" method="post">

        <h2>Transcript</h2>
          <div class="slidecontainer">
            <input type="range" min="1" max="5" value="1" class="slider" name="transcript-range">
          </div>
        
        <h2>Composition</h2>
          <div class="slidecontainer">
            <input type="range" min="1" max="5" value="1" class="slider" name="composition-range">
          </div>
        
        <h2>Writing Process</h2>
          <div class="slidecontainer">
            <input type="range" min="1" max="5" value="1" class="slider" name="writing-process-range">
          </div>

        <button> Next </button>
        
      </form>

      <div class="key">
        <h2>Key</h2>
          <h3>1 - Emerging</h3>
          <h3>2 - Developing</h3>
          <h3>3 - Consolidating</h3>
          <h3>4 - Proficient</h3>
          <h3>5 - Exceeding</h3>
      </div>

    </section>

{% endblock %}

