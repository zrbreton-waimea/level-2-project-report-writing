{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Class Room </h1>
    </nav>
  </header>

    <section id="writing">
      <form class="writing-form" method="post">

        <legend>Transcript</legend>
          <div class="slide-container">
            <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-i" name="transcript-range">
            <datalist id="step-list-i">
            <option value="1" label="1"></option>
            <option value="2" label="2"></option>
            <option value="3" label="3"></option>
            <option value="4" label="4"></option>
            <option value="5" label="5"></option>
            </datalist>
          </div>
        
        <legend>Composition</legend>
          <div class="slide-container">
            <input type="range" min="1" max="5" step="1" valegende="1" class="slider" list="step-list-j" name="composition-range">
            <datalist id="step-list-j">
            <option value="1" label="1"></option>
            <option value="2" label="2"></option>
            <option value="3" label="3"></option>
            <option value="4" label="4"></option>
            <option value="5" label="5"></option>
            </datalist>
          </div>
        
        <legend>Writing Process</legend>
          <div class="slide-container">
            <input type="range" min="1" max="5" step="1" value="1" class="slider" list="step-list-k" name="writing-process-range">
            <datalist id="step-list-k">
            <option value="1" label="1"></option>
            <option value="2" label="2"></option>
            <option value="3" label="3"></option>
            <option value="4" label="4"></option>
            <option value="5" label="5"></option>
            </datalist>
          </div>
        
        <legend>Effort</legend>
          <div class="checkbox-container">
          <p>Is the student displaying a consistent effort for Writing? Tick the box for yes, leave blank for no.</p>
            <input type="checkbox" name="writing-effort">
          </div>

        <button> Next </button>
        
      </form>

      <div class="key">
        <legend>Key</legend>
          <h3>1 - Emerging</h3>
          <h3>2 - Developing</h3>
          <h3>3 - Consolidating</h3>
          <h3>4 - Proficient</h3>
          <h3>5 - Exceeding</h3>
      </div>

    </section>

{% endblock %}

