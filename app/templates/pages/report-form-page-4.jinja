{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
  <header>
    <nav>
      <div class="back-btn">
        <a href="/"><img src="/static/images/circle-arrow-left.svg" alt="back-button-icon"></a>
      </div>
      <h1> Class Room </h1>
    </nav>
  </header>

    <section id="comments">
      <form class="comments-form" method="post">

        <legend>Maths</legend>
          <div class="text-input">
            <input type="text" name="math-text">
          </div>
        
        <legend>Reading</legend>
          <div class="text-input">
            <input type="text" name="reading-text">
          </div>
        
        <legend>Writing</legend>
          <div class="text-input">
            <input type="text" name="writing-text">
          </div>

        <legend>Behaviour</legend>
          <div class="text-input">
            <input type="text" name="behaviour-text">
          </div>

        <button> Next </button>
        
      </form>

      <div class="key">
        <legend>Key</legend>
          <h3>1 - Emerging</h3>
          <h3>2 - Developing</h3>
          <h3>3 - Consolidating</h3>
          <h3>4 - Proficient</h3>
          <h3>5 - Exceeding</h3>
      </div>
    </section>

{% endblock %}

